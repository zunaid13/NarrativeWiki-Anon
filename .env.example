# Copy to .env and fill in what you have. Every value here is OPTIONAL.
# With no API key at all the pipeline runs entirely on the local model; the only difference is
# that the final character prose is less polished. Nothing else changes.

# --- Local model (Ollama) ---------------------------------------------------
# Where the Ollama server is. Leave unset for the default.
OLLAMA_HOST=http://localhost:11434

# --- API providers (optional) -----------------------------------------------
# Which of these is actually used is decided by config/models.yaml `routing`, not by which
# keys are present. A role whose key is missing silently falls back to its local `fallback`.
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY is retired (2026-09-28): Gemini runs on Vertex AI only -- GOOGLE_CLOUD_PROJECT below.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Groq (console.groq.com/keys) — free tier, fast (low-latency inference), generous rate limits.
# Good default fallback for prose/codex_summary/arbitrate when Mistral/Google keys are
# missing or exhausted. See config/models.yaml `groq_fast`/`groq_prose`.
GROQ_API_KEY=

# Vertex AI (paid, uses your Google Cloud project's billing/credits, not an API key). Only
# read when a profile sets `use_vertex: true` (config/models.yaml `vertex_frontier`/
# `vertex_frontier_pro`) -- and those are never in `routing:`, so they only spend when you pass
# `--model <stage>=vertex_frontier` explicitly. See llm/providers/google.py.
GOOGLE_CLOUD_PROJECT=
# `global` is required for the gemini-3.x family; regional endpoints 404 on them.
GOOGLE_CLOUD_LOCATION=global
# Path to the Application Default Credentials JSON from `gcloud auth application-default login`.
# The google-genai SDK reads this env var itself; unset means it looks in the gcloud default
# location instead, which also works.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Overrides (optional) ---------------------------------------------------
# Which series config to load; also settable per-command with --series.
NARRATIVEWIKI_SERIES=anne

# Set to 1 to write every prompt and response to data/cache/llm/prompts.log. Useful when
# tuning prompts, noisy otherwise.
NARRATIVEWIKI_LOG_PROMPTS=0
